{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.kernelcad/kernelcad",
  "title": "kernelCAD",
  "description": "CAD in ChatGPT and Claude: editable parts, STEP/STL/drawings, in-chat 3D, automatic checks.",
  "repository": {
    "url": "https://github.com/w1ne/kernelCAD-web",
    "source": "github"
  },
  "websiteUrl": "https://kernelcad.com/",
  "version": "0.17.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "kernelcad",
      "version": "0.17.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.kernelcad.com/mcp"
    }
  ]
}
