# `@google/model-viewer@4.2.x` declares peer `three@^0.182.0`, but the root
# project (Vite SPA + drei + fiber) is on `three@^0.184.0`. The conflict is
# benign — model-viewer's three usage is compatible with 0.184 in practice
# — and the shim is what unblocked the develop merge that brought the
# Vite-side three upgrade. Remove this line if model-viewer relaxes its
# peer constraint (track @google/model-viewer release notes).
legacy-peer-deps=true
