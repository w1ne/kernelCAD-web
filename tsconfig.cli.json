{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": false,
    "declaration": false,
    "tsBuildInfoFile": null,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noUncheckedSideEffectImports": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src/agent/cli/**/*", "src/agent/script-runtime/**/*",
              "src/agent/render/**/*",
              "src/authoring/validation/**/*", "src/authoring/runtime/**/*",
              "src/kernel/backends/**/*",
              "src/shared/diagnostics/**/*",
              "src/shared/worker/geometryHelpers.ts", "src/shared/worker/safeSketch.ts",
              "src/shared/worker/userGlobals.ts", "src/shared/worker/withTemporaryGlobals.ts",
              "src/shared/worker/workerTypes.ts",
              "src/agent/cookbook/**/*", "src/modeling/**/*", "src/kernel/naming/**/*",
              "src/shared/types/**/*"],
  "exclude": ["src/studio/**/*",
              "src/modeling/features/**/*", "src/modeling/HeadlessKernel.ts",
              "src/kernel/backends/occt/worker.ts",
              "tests/**/*", "**/*.test.ts"]
}
