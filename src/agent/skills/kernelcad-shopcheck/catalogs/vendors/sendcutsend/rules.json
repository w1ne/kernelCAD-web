{
  "schemaVersion": 1,
  "version": "scs-1.0.0",
  "vendor": "sendcutsend",
  "rules": [
    { "id": "scs.units.dxf-must-be-mm",              "description": "DXF $INSUNITS = 4",                  "scope": "units",      "appliesTo": {},                                     "check": { "kind": "enum", "allowed": ["4"] },                                                                                "diagnosticCode": "dfm.units.dxf-not-mm",                 "severity": "error",                                                            "ruleSource": "direct file inspection" },
    { "id": "scs.material.sku-in-catalog",           "description": "material in catalog",                "scope": "material",   "appliesTo": {},                                     "check": { "kind": "enum", "allowed": ["aluminum-6061-t6", "mild-steel-1018", "acrylic-cast", "delrin"] },                     "diagnosticCode": "dfm.material.unknown-sku",             "severity": "error", "repairAction": "change-material",                         "ruleSource": "catalog.json" },
    { "id": "scs.thickness.in-stocked-gauges",       "description": "thickness in stocked gauges",        "scope": "thickness",  "appliesTo": {},                                     "check": { "kind": "expression", "formula": "thicknessIn IN catalog[sku].thicknessesIn" },                                    "diagnosticCode": "dfm.thickness.not-stocked",            "severity": "error", "repairAction": "change-thickness",                        "ruleSource": "catalog.json" },
    { "id": "scs.laser.min-hole-50pct-thickness",    "description": "min hole = 50% of thickness",        "scope": "hole",       "appliesTo": { "services": ["laser"] },              "check": { "kind": "min", "threshold": 0.5, "units": "multiplier-of-thickness" },                                             "diagnosticCode": "dfm.hole.below-minimum",               "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "/laser-cutting/" },
    { "id": "scs.laser.min-hole-per-material",       "description": "min hole per material+thickness",    "scope": "hole",       "appliesTo": { "services": ["laser"] },              "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.0625, "mild-steel-1018": 0.030 } }, "units": "in" }, "diagnosticCode": "dfm.hole.below-minimum",            "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "specs.json" },
    { "id": "scs.laser.min-slot-width",              "description": "min slot width",                     "scope": "slot",       "appliesTo": { "services": ["laser"] },              "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.063 } }, "units": "in" },                     "diagnosticCode": "dfm.slot.below-minimum",               "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "specs.json" },
    { "id": "scs.laser.min-web-width",               "description": "min bridge width between cutouts",   "scope": "web",        "appliesTo": { "services": ["laser"] },              "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.060 } }, "units": "in" },                     "diagnosticCode": "dfm.web.below-minimum",                "severity": "error", "repairAction": "relocate",                                "ruleSource": "specs.json" },
    { "id": "scs.laser.thickness-range",             "description": "laser thickness 0.015-0.750 in",     "scope": "thickness",  "appliesTo": { "services": ["laser"] },              "check": { "kind": "min", "threshold": 0.015, "units": "in" },                                                                "diagnosticCode": "dfm.thickness.out-of-range",           "severity": "error", "repairAction": "change-thickness",                        "ruleSource": "/laser-cutting/" },
    { "id": "scs.bending.material-supported",        "description": "material is bendable",               "scope": "material",   "appliesTo": { "services": ["bending"] },            "check": { "kind": "enum", "allowed": ["aluminum-6061-t6", "mild-steel-1018"] },                                              "diagnosticCode": "dfm.bending.material-unsupported",     "severity": "error", "repairAction": "change-material",                         "ruleSource": "/bending/" },
    { "id": "scs.bending.thickness-range",           "description": "bending thickness 0.030-0.250 in",   "scope": "thickness",  "appliesTo": { "services": ["bending"] },            "check": { "kind": "max", "threshold": 0.250, "units": "in" },                                                                "diagnosticCode": "dfm.thickness.out-of-range-for-service","severity": "error", "repairAction": "change-thickness",                        "ruleSource": "/bending/" },
    { "id": "scs.bending.min-radius-per-thickness",  "description": "min bend radius per material",       "scope": "bend",       "appliesTo": { "services": ["bending"] },            "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.094, "mild-steel-1018": 0.063 } }, "units": "in" }, "diagnosticCode": "dfm.bend.radius-below-minimum",     "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "specs.json" },
    { "id": "scs.bending.max-angle",                 "description": "|angle| <= 130 deg",                 "scope": "bend",       "appliesTo": { "services": ["bending"] },            "check": { "kind": "max", "threshold": 130, "units": "mm" },                                                                  "diagnosticCode": "dfm.bend.angle-too-acute",             "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "/bending/" },
    { "id": "scs.bending.max-length",                "description": "bend length <= 44 in",               "scope": "bend",       "appliesTo": { "services": ["bending"] },            "check": { "kind": "max", "threshold": 44, "units": "in" },                                                                   "diagnosticCode": "dfm.bend.length-exceeds-max",          "severity": "warn",                                                              "ruleSource": "/bending/" },
    { "id": "scs.bending.flange-before-bend",        "description": "min flange before bend",             "scope": "flange",     "appliesTo": { "services": ["bending"] },            "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.500 } }, "units": "in" },                     "diagnosticCode": "dfm.bend.flange-too-short",            "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "specs.json" },
    { "id": "scs.bending.flange-after-bend",         "description": "min flange after bend",              "scope": "flange",     "appliesTo": { "services": ["bending"] },            "check": { "kind": "min", "threshold": { "perMaterial": { "aluminum-6061-t6": 0.500 } }, "units": "in" },                     "diagnosticCode": "dfm.bend.flange-too-short",            "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "specs.json" },
    { "id": "scs.bending.channel-ratio",             "description": "channel base >= 2x flange",          "scope": "flange",     "appliesTo": { "services": ["bending"] },            "check": { "kind": "expression", "formula": "channelBase >= 2 * flange" },                                                   "diagnosticCode": "dfm.bend.channel-ratio-too-low",       "severity": "warn",                                                              "ruleSource": "/bending/" },
    { "id": "scs.size.max-instant-quote",            "description": "<= 44 x 30 in",                      "scope": "sheet-size", "appliesTo": {},                                     "check": { "kind": "max", "threshold": { "perMaterial": { "*": 44 } }, "units": "in" },                                       "diagnosticCode": "dfm.size.exceeds-instant-quote",       "severity": "warn",                                                              "ruleSource": "/materials/min-max/" },
    { "id": "scs.size.max-custom-quote",             "description": "<= 56 x 30 in (Al) / vendor max",    "scope": "sheet-size", "appliesTo": {},                                     "check": { "kind": "max", "threshold": { "perMaterial": { "aluminum-6061-t6": 56, "*": 44 } }, "units": "in" },               "diagnosticCode": "dfm.size.exceeds-max",                 "severity": "error", "repairAction": "relocate",                                "ruleSource": "/materials/min-max/" },
    { "id": "scs.size.min-part-size",                "description": ">= category minimum",                "scope": "sheet-size", "appliesTo": {},                                     "check": { "kind": "min", "threshold": { "perMaterial": { "*": 0.25 } }, "units": "in" },                                     "diagnosticCode": "dfm.size.below-minimum",               "severity": "error", "repairAction": "enlarge",                                 "ruleSource": "/materials/min-max/" },
    { "id": "scs.dxf.no-splines",                    "description": "DXF cut layer is LWPOLYLINE only",   "scope": "units",      "appliesTo": {},                                     "check": { "kind": "enum", "allowed": ["LWPOLYLINE"] },                                                                       "diagnosticCode": "dfm.dxf.spline-present",               "severity": "error",                                                            "ruleSource": "direct file inspection" },
    { "id": "scs.dxf.bend-layer-present",            "description": "BEND layer exists when bend lines",  "scope": "bend",       "appliesTo": {},                                     "check": { "kind": "expression", "formula": "if source.bendLines.length > 0 then dxf.layers includes BEND" },                "diagnosticCode": "dfm.bend.layer-missing",               "severity": "error",                                                            "ruleSource": "Slice A contract item 3" }
  ]
}
