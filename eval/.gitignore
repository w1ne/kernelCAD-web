# Live runs are not committed; only golden fixtures (runs/golden-*) are.
runs/*
!runs/golden-*/

# Agent-eval results ARE committed: eval/results/<date>-<model>.json and the
# pass@1 baseline the regression gate compares against (eval/mech40/compare.ts).
!results/

# Python bytecode from eval/oracle wrappers
__pycache__/
*.pyc
