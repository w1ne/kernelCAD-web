{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "verb-nurbs": ["./vendor/verb-nurbs/build/verb.es.js"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "//include": "Kept from the deleted app project: the example-typecheck wrapper config (scripts/typecheckExamples.ts) inherits this include so ambient declarations under src/ stay in its program. tsconfig.cli.json and tsconfig.site.json override include/exclude for themselves.",
  "include": ["src", "site/island"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**",
    "src/agent/cli/**",
    "src/agent/workflows/**",
    "src/agent/skills/**/cookbook/**/*.kcad.ts"
  ]
}
