{
  "//": "Type-checks the marketing site build scripts and islands without the Studio app project.",
  "extends": "./tsconfig.cli.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "site/scripts/**/*.ts",
    "site/island/**/*.ts",
    "site/island/**/*.tsx",
    "site/lib/**/*.ts",
    "site/lib/**/*.tsx",
    "src/shared/types/**/*",
    "src/kernel/backends/verb/verb-nurbs.d.ts"
  ],
  "exclude": ["site/scripts/**/*.test.ts", "site/island/**/*.test.ts"]
}
